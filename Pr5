int** addRowEnd(int** arr, int& rows, int cols, int* newRow) {
    int** temp = new int* [rows + 1];

    for (int i = 0; i < rows + 1; i++) {
        temp[i] = new int[cols];
    }

    for (int i = 0; i < rows; i++) {
        for (int j = 0; j < cols; j++)
            temp[i][j] = arr[i][j];
    }

    for (int j = 0; j < cols; j++)
        temp[rows][j] = newRow[j];

    for (int i = 0; i < rows; i++) {
        delete[] arr[i];
    }
    delete[] arr;

    rows++;

    return temp;
}

int** addRowBegin(int** arr, int& rows, int cols, int* newRow) {
    int** temp = new int* [rows + 1];

    for (int i = 0; i < rows + 1; i++)
        temp[i] = new int[cols];

    for (int j = 0; j < cols; j++)
        temp[0][j] = newRow[j];

    for (int i = 0; i < rows; i++)
        for (int j = 0; j < cols; j++)
            temp[i + 1][j] = arr[i][j];

    for (int i = 0; i < rows; i++)
        delete[] arr[i];
    delete[] arr;

    rows++;

    return temp;
}

int** AddRowAtPos(int** arr, int& rows, int cols, int* newRow, int pos) {
    int** temp = new int* [rows + 1];

    for (int i = 0; i < rows + 1; i++)
        temp[i] = new int[cols];

    for (int i = 0; i < pos; i++)
        for (int j = 0; j < cols; j++)
            temp[i][j] = arr[i][j];

    for (int j = 0; j < cols; j++)
        temp[pos][j] = newRow[j];

    for (int i = pos; i < rows; i++)
        for (int j = 0; j < cols; j++)
            temp[i + 1][j] = arr[i][j];

    for (int i = 0; i < rows; i++)
        delete[] arr[i];
    delete[] arr;

    rows++;

    return temp;
}

int** multiplyMatrices(int** firstMatrix, int firstRows, int firstCols, int** secondMatrix, int secondCols) {
    int** resultMatrix = new int* [firstRows];
    for (int i = 0; i < firstRows; i++) {
        resultMatrix[i] = new int[secondCols];
        for (int j = 0; j < secondCols; j++) {
            resultMatrix[i][j] = 0;
            for (int k = 0; k < firstCols; k++) {
                resultMatrix[i][j] += firstMatrix[i][k] * secondMatrix[k][j];
            }
        }
    }
    return resultMatrix;
}

int** convert1DTo2D(int* arr1D, int size1D, int& outRows, int& outCols) {
    cout << "Total elements: " << size1D << "\nPossible variants:\n";
    bool hasVariants = false;
    for (int i = 2; i <= size1D / 2; i++) {
        if (size1D % i == 0) {
            cout << "- " << i << " rows x " << size1D / i << " cols\n";
            hasVariants = true;
        }
    }
    if (!hasVariants) return nullptr;

    cout << "Enter target rows: "; cin >> outRows;
    cout << "Enter target cols: "; cin >> outCols;

    if (outRows * outCols != size1D) return nullptr;

    int** res = new int* [outRows];
    int index = 0;
    for (int i = 0; i < outRows; i++) {
        res[i] = new int[outCols];
        for (intj = 0; j < outCols; j++) {
            res[i][j] = arr1D[index++];
        }
    }
    return res;
}
